{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "gamehub",
	"compatibility_date": "2026-04-15",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding; service name must match worker name
			// https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "gamehub"
		}
	],
	"images": {
		// https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
			"binding": "CONTENT_R2",
			"bucket_name": "pasttime-content"
		}
	],
	"d1_databases": [
		{
			"binding": "LEXICON_DB",
			"database_name": "pasttime-lexicon",
			"database_id": "697cf152-bc49-4be7-9239-dbce9f1be8d1",
			"migrations_dir": "migrations"
		}
	]
}
