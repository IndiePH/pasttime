{
  "name": "@pasttime/web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "word-guess:build-dictionary": "node scripts/word-guess/build-dictionary.mjs",
    "crossword:collect-definitions": "node scripts/crossword/collect-definitions.mjs",
    "crossword:build-enriched": "node scripts/crossword/build-enriched.mjs",
    "crossword:backup-pipeworx": "node scripts/crossword/backup-pipeworx.mjs",
    "crossword:build-clues": "node scripts/crossword/build-clues.mjs",
    "preview:stop": "taskkill /F /IM workerd.exe 2>nul || exit 0",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:serve": "opennextjs-cloudflare build --skipNextBuild && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@pasttime/api-client": "*",
    "@pasttime/domain": "*",
    "@pasttime/storage": "*",
    "@remixicon/react": "^4.9.0",
    "@stdlib/datasets-female-first-names-en": "^0.2.3",
    "@stdlib/datasets-male-first-names-en": "^0.2.3",
    "all-the-cities": "^3.1.0",
    "an-array-of-english-words": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-list": "^2.4.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.9",
    "nuqs": "^2.8.9",
    "popular-english-words": "^1.0.2",
    "radix-ui": "^1.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "wrangler": "^4.99.0"
  }
}
