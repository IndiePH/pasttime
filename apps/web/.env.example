NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Resend (server-only — never NEXT_PUBLIC_*)
# Copy real values to .env.local; do not commit secrets
RESEND_API_KEY=re_xxxxxxxx
FEEDBACK_TO_EMAIL=you@example.com
FEEDBACK_FROM_EMAIL=Pasttime <feedback@pasttime.xyz>

# AdSense (optional; leave unset for placeholders)
# Publisher ID: use ca-pub-… (if AdSense UI shows pub-…, add the ca- prefix)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
# NEXT_PUBLIC_ADSENSE_SLOT_HUB=
