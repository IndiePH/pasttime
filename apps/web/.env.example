NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Resend (server-only — never NEXT_PUBLIC_*; never commit real values)
# Production: Worker Secrets on gamehub (see docs/DEPLOY.md)
RESEND_API_KEY=re_xxxxxxxx
FEEDBACK_TO_EMAIL=you@example.com
FEEDBACK_FROM_EMAIL=Pasttime <feedback@pasttime.xyz>

# AdSense — production source of truth: apps/web/wrangler.jsonc "vars"
# UI may show pub-… only; use ca-pub-… here (same digits). Slot values = numeric IDs.
# Unit names in AdSense (labels only): pasttime-global-top-strip, pasttime-global-bottom-strip, pasttime-hub-grid-card
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT_TOP=
# NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
# NEXT_PUBLIC_ADSENSE_SLOT_HUB=
